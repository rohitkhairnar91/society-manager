rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email != null && request.auth.token.email_verified == true; }
    function myEmail() { return request.auth.token.email.lower(); }
    function adminPath() { return /databases/$(database)/documents/admins/$(myEmail()); }
    function memberPath() { return /databases/$(database)/documents/members/$(myEmail()); }
    function setupPath() { return /databases/$(database)/documents/config/setup; }
    function isOwner() { return verified() && exists(setupPath()) && get(setupPath()).data.firstAdmin == myEmail(); }
    function isAdminDoc() { return verified() && exists(adminPath()); }
    function role() { return get(adminPath()).data.get('role', 'chairman'); }
    function isCommittee() { return isOwner() || isAdminDoc(); }
    function canManage() { return isOwner() || (isAdminDoc() && role() in ['chairman', 'secretary']); }
    function canAccounts() { return isOwner() || (isAdminDoc() && role() in ['chairman', 'treasurer']); }
    function isResident() { return verified() && exists(memberPath()) && get(memberPath()).data.status == 'approved'; }
    function canRead() { return isCommittee() || isResident(); }
    function ownsFlat(flatId) { return isResident() && get(memberPath()).data.flatId == flatId && get(memberPath()).data.relation in ['Owner', 'Tenant']; }
    function joinKeys() { return ['email', 'name', 'phone', 'flatId', 'flatNumber', 'relation', 'status', 'requestedAt']; }
    function cmpPath(id) { return /databases/$(database)/documents/complaints/$(id); }

    match /{document=**} { allow read, write: if isOwner(); }

    match /admins/{email} {
      allow read: if signedIn();
      allow create, update, delete: if canManage();
      allow create: if verified() && email == myEmail()
        && !exists(/databases/$(database)/documents/config/setup)
        && existsAfter(/databases/$(database)/documents/config/setup);
    }
    match /config/setup {
      allow read: if signedIn();
      allow create: if verified() && existsAfter(adminPath()) && request.resource.data.firstAdmin == myEmail();
      allow update, delete: if false;
    }
    match /config/flatIndex { allow read: if signedIn(); allow write: if canManage(); }
    match /config/society { allow read: if canRead(); allow write: if canManage() || canAccounts(); }
    match /config/backup { allow read: if isCommittee(); allow write: if canManage(); }

    match /members/{email} {
      allow get: if verified() && (email == myEmail() || isCommittee());
      allow list: if isCommittee();
      allow create, update: if verified() && email == myEmail()
        && (resource == null || resource.data.status in ['pending', 'rejected'])
        && request.resource.data.status == 'pending'
        && request.resource.data.email == myEmail()
        && request.resource.data.keys().hasOnly(joinKeys())
        && request.resource.data.relation in ['Owner', 'Tenant', 'Family'];
      allow update, delete: if canManage();
      allow delete: if verified() && email == myEmail();
    }

    match /flats/{id} {
      allow read: if canRead();
      allow create, delete: if canManage();
      allow update: if canManage() || canAccounts()
        || (ownsFlat(id) && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['owner', 'phone', 'tenant', 'tenantPhone', 'leaseEnd', 'email', 'members', 'vehicle', 'parking', 'notes', 'occupancy']));
    }
    match /dues/{month}       { allow read: if canRead(); allow write: if canAccounts(); }
    match /activities/{id}    { allow read: if canRead(); allow write: if isCommittee(); }
    match /announcements/{id} { allow read: if canRead(); allow write: if isCommittee(); }
    match /meetings/{id}      { allow read: if canRead(); allow write: if canManage(); }
    match /expenses/{id}      { allow read: if canRead(); allow write: if canAccounts(); }
    match /bills/{id}         { allow read: if canRead(); allow write: if canAccounts(); }

    match /cmpPhotos/{id} {
      allow get: if isCommittee()
        || (canRead() && (get(cmpPath(id)).data.anonymous == true || get(cmpPath(id)).data.get('byEmail', '') == myEmail()));
      allow create: if canRead() && !exists(cmpPath(id)) && existsAfter(cmpPath(id))
        && request.resource.data.keys().hasOnly(['imgs', 'at'])
        && request.resource.data.imgs is list && request.resource.data.imgs.size() <= 3;
      allow delete: if canManage();
    }
    match /complaints/{id} {
      allow create: if canRead()
        && request.resource.data.status == 'Open'
        && request.resource.data.keys().hasOnly(['title', 'details', 'category', 'anonymous', 'byEmail', 'byName', 'flat', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 120
        && request.resource.data.details is string && request.resource.data.details.size() <= 2000
        && ((request.resource.data.anonymous == true
              && !('byEmail' in request.resource.data) && !('byName' in request.resource.data) && !('flat' in request.resource.data))
            || (request.resource.data.anonymous == false && request.resource.data.byEmail == myEmail()));
      allow get: if isCommittee() || (canRead() && (resource.data.anonymous == true || resource.data.byEmail == myEmail()));
      allow list: if isCommittee() || (canRead() && resource.data.byEmail == myEmail());
      allow update: if isCommittee()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reply', 'updatedAt', 'repliedBy']);
      allow delete: if canManage();
    }
    // END OF RULES
  }
}
