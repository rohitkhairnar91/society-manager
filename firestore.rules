rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    function verified() { return signedIn() && request.auth.token.email != null && request.auth.token.email_verified == true; }
    function isAdmin() { return verified() && exists(/databases/$(database)/documents/admins/$(myEmail())); }

    // Committee members (admins). Document id = lower-case email.
    match /admins/{email} {
      allow read: if signedIn();
      // Normal case: an existing admin adds or removes someone.
      allow create, update, delete: if isAdmin();
      // First-time setup only: the very first person claims admin, in the same
      // write that creates config/setup. Once config/setup exists this is closed.
      allow create: if verified() && email == myEmail()
        && !exists(/databases/$(database)/documents/config/setup)
        && existsAfter(/databases/$(database)/documents/config/setup);
    }

    match /config/setup {
      allow read: if signedIn();
      allow create: if verified()
        && existsAfter(/databases/$(database)/documents/admins/$(myEmail()));
      allow update, delete: if false;
    }

    // Society data: any signed-in user can read, only committee can write.
    match /config/society { allow read: if signedIn(); allow write: if isAdmin(); }
    match /flats/{id}      { allow read: if signedIn(); allow write: if isAdmin(); }
    match /dues/{month}    { allow read: if signedIn(); allow write: if isAdmin(); }
    match /activities/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
  }
}
